<?xml version="1.0" encoding="UTF-8"?>
<!-- AutoLiquid 2. Mesmo id do painel 1 (com.autoliquid.panel): instalar por
     cima substitui a versão antiga. -->
<ExtensionManifest Version="7.0" ExtensionBundleId="com.autoliquid.panel" ExtensionBundleVersion="2.0.0"
    ExtensionBundleName="AutoLiquid" xmlns:ExtensionList="http://ns.adobe.com/extension-list/1.0">
    <ExtensionList>
        <Extension Id="com.autoliquid.panel.main" Version="2.0.0" />
    </ExtensionList>
    <ExecutionEnvironment>
        <HostList>
            <Host Name="ILST" Version="[17.0,99.9]" />
        </HostList>
        <LocaleList>
            <Locale Code="All" />
        </LocaleList>
        <RequiredRuntimeList>
            <RequiredRuntime Name="CSXS" Version="9.0" />
        </RequiredRuntimeList>
    </ExecutionEnvironment>
    <DispatchInfoList>
        <Extension Id="com.autoliquid.panel.main">
            <DispatchInfo>
                <Resources>
                    <MainPath>./index.html</MainPath>
                    <ScriptPath>./jsx/host.jsx</ScriptPath>
                </Resources>
                <Lifecycle>
                    <AutoVisible>true</AutoVisible>
                </Lifecycle>
                <UI>
                    <Type>Panel</Type>
                    <Menu>AutoLiquid</Menu>
                    <Geometry>
                        <Size>
                            <Height>600</Height>
                            <Width>320</Width>
                        </Size>
                        <MinSize>
                            <Height>360</Height>
                            <Width>260</Width>
                        </MinSize>
                        <MaxSize>
                            <Height>1000</Height>
                            <Width>520</Width>
                        </MaxSize>
                    </Geometry>
                    <!-- Ícone do painel recolhido na doca. PNG 23x23 + @2X (46x46),
                         gerados por tools/make-icons.js. Normal/RollOver = temas
                         claros da UI; Dark* = temas escuros. -->
                    <Icons>
                        <Icon Type="Normal">./icons/icon-normal.png</Icon>
                        <Icon Type="RollOver">./icons/icon-rollover.png</Icon>
                        <Icon Type="DarkNormal">./icons/icon-dark-normal.png</Icon>
                        <Icon Type="DarkRollOver">./icons/icon-dark-rollover.png</Icon>
                    </Icons>
                </UI>
            </DispatchInfo>
        </Extension>
    </DispatchInfoList>
</ExtensionManifest>
