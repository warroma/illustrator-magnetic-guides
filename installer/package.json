{
  "name": "autoliquid-installer",
  "version": "2.0.0",
  "private": true,
  "description": "Instalador do painel AutoLiquid para Adobe Illustrator (Windows/macOS)",
  "main": "src/main.js",
  "scripts": {
    "sync-panel": "node ../tools/install-panel.js",
    "prestart": "npm run sync-panel",
    "start": "electron .",
    "test": "node test/detect.test.js && node test/install.test.js && node test/bundle.test.js",
    "predist": "npm run sync-panel",
    "dist": "electron-builder --publish never"
  },
  "devDependencies": {
    "electron": "44.7.0",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "com.autoliquid.installer",
    "productName": "AutoLiquid Installer",
    "icon": "build/icon.png",
    "files": [
      "src/**/*"
    ],
    "extraResources": [
      { "from": "../panel", "to": "com.autoliquid.panel", "filter": ["**/*", "!.debug"] }
    ],
    "mac": {
      "target": [{ "target": "dmg", "arch": ["universal"] }],
      "category": "public.app-category.graphics-design",
      "artifactName": "AutoLiquid-Instalador-macOS.${ext}"
    },
    "win": {
      "target": "portable",
      "artifactName": "AutoLiquid-Instalador-Windows.${ext}"
    }
  }
}
